# findplus configuration. Copy to `.env` and edit.
# `.env` is gitignored. No credentials belong in this file — auth material lives
# in ~/.findplus/secrets.json, written by `findplus auth`.

# --- Polling ---------------------------------------------------------------
# Minutes between Find Hub queries. 5 is the enforced floor; going below it
# risks Google rate-limiting or flagging the account.
POLL_INTERVAL_MINUTES=5

# Set to true ONLY if you accept the rate-limiting risk of sub-5-minute polling.
ALLOW_FAST_POLLING=false

# Seconds to wait for Find Hub's push response before giving up on one poll.
POLL_TIMEOUT_SECONDS=90

# Cap on exponential backoff after consecutive failures.
POLL_MAX_BACKOFF_MINUTES=60

# --- Analysis --------------------------------------------------------------
# Hops shorter than this are treated as Bluetooth jitter, not bike movement.
# Raw observations are still stored either way.
MOVEMENT_THRESHOLD_METERS=25

# A silence longer than this is drawn as a gap in the timeline.
GAP_THRESHOLD_MINUTES=20

# Fallback accuracy used when a fix has no accuracy_meters value.
GEOFENCE_DEFAULT_ACCURACY_METERS=100.0

# --- Groups / presence ------------------------------------------------------
# How far back a member's last fix can be and still count as reporting.
PRESENCE_WINDOW_MINUTES=60

# Half-width of the window used to match member place-events into one group event.
GROUP_WINDOW_MINUTES=30

# --- Alerts ------------------------------------------------------------------
# Master switch: false skips alert dispatch entirely.
ALERTS_ENABLED=true

# --- Widget ------------------------------------------------------------------
# Default for whether the macOS widget shows a map.
WIDGET_SHOW_MAP=false

# --- Retention -------------------------------------------------------------
# 0 = keep history forever (the default). History is never deleted silently.
RETENTION_DAYS=0

# --- Storage ---------------------------------------------------------------
# DATABASE_PATH=/path/to/findplus.sqlite
# STATE_DIR=/Users/you/.findplus

# --- Local server ----------------------------------------------------------
# Loopback only. Binding elsewhere requires FINDPLUS_ALLOW_PUBLIC_BIND=1.
HOST=127.0.0.1
PORT=8647

# How often the browser refreshes from the LOCAL API. This does NOT query Google.
UI_REFRESH_SECONDS=45

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
