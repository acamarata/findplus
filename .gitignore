# --- Authentication material — NEVER COMMIT -------------------------------
secrets.json
*secrets*.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.cookie
cookies.txt
Auth/secrets.json
vendor/GoogleFindMyTools/Auth/secrets.json
vendor/GoogleFindMyTools/example_data.json
.findplus/
token_cache*
# the vendored upstream module of that name is source code, not a cache file
!cli/vendor/GoogleFindMyTools/Auth/token_cache.py
*.token

# --- Location history — private by default --------------------------------
data/
# packaging/data/ holds pinned build inputs, not location history. The
# directory itself has to be un-excluded: git cannot re-include a path under an
# excluded directory.
!packaging/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
exports/
*.gpx
*.kml

# --- Logs ------------------------------------------------------------------
logs/
*.log

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- AI working memory (never committed) ------------------------------------
.claude/
.opencode/

# Desktop / packaging
desktop/src-tauri/target/
desktop/src-tauri/gen/schemas/
# binaries/findplus-daemon-<triple> are committed launcher scripts; the
# PyInstaller onedir they exec is build output and ships as a bundle resource.
desktop/src-tauri/resources/
desktop/widget/build/
desktop/widget/reload-widgets
desktop/widget/*.xcodeproj/xcuserdata/
desktop/widget/*.xcodeproj/project.xcworkspace/xcuserdata/
packaging/dist/
packaging/*.dmg
packaging/*.pkg
packaging/homebrew/findplus.rb
/FindPlus-*.dmg
/FindPlus-*.dmg.sha256

# AI tooling
.cursor/
.aider/
*.aider*

# macOS
*.xcuserstate
