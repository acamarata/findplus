{
  "manifest_version": 3,
  "name": "Find+ helper",
  "version": "1.2.3",
  "description": "Connects your Google Find Hub account to Find+ running on this same computer. Talks only to Google's sign-in page and to Find+ on 127.0.0.1. Open source, no analytics, no remote code.",
  "key": "",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://accounts.google.com/*", "http://127.0.0.1:8647/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8647/auth/google/begin*", "http://127.0.0.1:8647/auth/google/unlock/begin*"],
      "js": ["content_begin.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://accounts.google.com/encryption/unlock/*"],
      "js": ["content_unlock_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://accounts.google.com/encryption/unlock/*"],
      "js": ["content_unlock_bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
