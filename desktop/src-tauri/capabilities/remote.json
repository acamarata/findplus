{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Grants the loopback dashboard origin core defaults plus notification permissions.",
  "remote": {
    "urls": ["http://127.0.0.1:8647/*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted"
  ]
}
